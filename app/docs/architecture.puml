@startuml architecture
' ============================================================
'  Food Recipe App (Community) - Domain Model & Repository
'  - 비즈니스 규칙(판정/가공)은 이 다이어그램에 그리지 않는다 → business_rules.md
'  - Repository 반환 타입 = "이 저장소가 주는 데이터"
' ============================================================

set separator none
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false
hide empty members

' ------------------------------------------------------------
' 0. 공통 결과 타입 (Repository 시그니처에 쓰이므로 함께 정의)
' ------------------------------------------------------------
package "core" {
  interface RootError <<marker>>

  interface "Result<out D, out E : RootError>" as Result <<sealed>>
  class "Success<D>" as Success {
    + data : D
  }
  class "Error<E>" as Failure {
    + error : E
  }
  Result <|.. Success
  Result <|.. Failure

  interface DataError <<sealed>>
  enum "DataError.Network" as NetworkError {
    NO_INTERNET
    TIMEOUT
    UNAUTHORIZED
    NOT_FOUND
    CONFLICT
    SERVER_ERROR
    UNKNOWN
  }
  enum "DataError.Local" as LocalError {
    DISK_FULL
    UNKNOWN
  }
  RootError <|-- DataError
  DataError <|.. NetworkError
  DataError <|.. LocalError
}

' ------------------------------------------------------------
' 1. 도메인 모델
' ------------------------------------------------------------
package "domain.model" {

  class User <<Profile 화면>> {
    + id : String
    + email : String
    + name : String
    + profileImageUrl : String?
    + job : String  // "Chef", "Private Chef"
    + bio : String
    + location : String?  // "Lagos, Nigeria"
    + recipeCount : Int
    + followerCount : Int
    + followingCount : Int
  }

  class UserSummary <<카드/리뷰용 요약>> {
    + id : String
    + name : String
    + profileImageUrl : String?
    + location : String?
  }

  class Recipe {
    + id : String
    + title : String
    + imageUrl : String
    + videoUrl : String?
    + chef : UserSummary
    + category : Category
    + rating : Double  // 평균 별점 (서버 집계)
    + reviewCount : Int  // "13k Reviews"
    + savedCount : Int  // "155 Saved"
    + cookingTimeMinutes : Int
    + servings : Int  // "1 serve"
    + ingredients : List<Ingredient>
    + procedures : List<Procedure>
    + shareUrl : String  // "app.Recipe.co/jollof_rice"
    + createdAt : Long
  }

  class Ingredient {
    + name : String
    + imageUrl : String
    + amountGram : Int  // "500g"
  }

  class Procedure {
    + step : Int
    + description : String
  }

  class Category {
    + id : String
    + name : String  // Indian, Italian, Asian, Breakfast ...
  }

  class SearchFilter <<검색 조건 값 객체>> {
    + sort : SortOption = ALL
    + rate : Int? = null  // 1..5, null = 전체
    + category : Category? = null
  }

  enum SortOption {
    ALL
    NEWEST
    OLDEST
    POPULARITY
  }

  class Review {
    + id : String
    + recipeId : String
    + author : UserSummary
    + content : String
    + likeCount : Int
    + dislikeCount : Int
    + createdAt : Long
  }

  class RecipeRating {
    + recipeId : String
    + userId : String
    + score : Int  // 1..5
  }

  class Notification {
    + id : String
    + type : NotificationType
    + title : String  // "New Recipe Alert!"
    + message : String
    + recipeId : String?
    + isRead : Boolean
    + createdAt : Long
  }

  enum NotificationType {
    NEW_RECIPE
    SAVED_RECIPE
  }

  enum SocialProvider {
    GOOGLE
    FACEBOOK
  }

  Recipe "1" *-- "1..*" Ingredient
  Recipe "1" *-- "1..*" Procedure
  Recipe "*" --> "1" Category
  Recipe "*" --> "1" UserSummary : chef
  Review "*" --> "1" UserSummary : author
  Review "*" ..> "1" Recipe : recipeId
  RecipeRating "*" ..> "1" Recipe : recipeId
  Notification --> NotificationType
  Notification ..> Recipe : recipeId?
  SearchFilter --> SortOption
  SearchFilter --> "0..1" Category
  User ..> UserSummary : 요약
}

' ------------------------------------------------------------
' 2. Repository 인터페이스 (데이터 접근만, 판정 로직 없음)
' ------------------------------------------------------------
package "domain.repository" {

  interface AuthRepository <<로그인/가입 · 세션>> {
    + signIn(email : String, password : String) : Result<User, DataError.Network>
    + signInWithSocial(provider : SocialProvider) : Result<User, DataError.Network>
    + signUp(name : String, email : String, password : String) : Result<User, DataError.Network>
    + signOut() : Result<Unit, DataError.Network>
    + getCurrentUser() : User?
  }

  interface UserRepository <<프로필>> {
    + getUser(userId : String) : Result<User, DataError.Network>
  }

  interface RecipeRepository <<레시피 원본 데이터>> {
    + getRecipes() : Result<List<Recipe>, DataError.Network>
    + getRecipe(recipeId : String) : Result<Recipe, DataError.Network>
    + getRecipesByChef(chefId : String) : Result<List<Recipe>, DataError.Network>
  }

  interface CategoryRepository <<카테고리 탭/필터 칩>> {
    + getCategories() : Result<List<Category>, DataError.Network>
  }

  interface RecentSearchRepository <<최근 검색 (로컬)>> {
    + getRecentRecipes() : Result<List<Recipe>, DataError.Local>
    + saveRecentRecipes(recipes : List<Recipe>) : Result<Unit, DataError.Local>
  }

  interface BookmarkRepository <<저장한 레시피>> {
    + getSavedRecipes() : Result<List<Recipe>, DataError.Network>
    + getSavedRecipeIds() : Result<Set<String>, DataError.Network>
    + saveRecipe(recipeId : String) : Result<Unit, DataError.Network>
    + unsaveRecipe(recipeId : String) : Result<Unit, DataError.Network>
  }

  interface ReviewRepository <<리뷰(댓글)>> {
    + getReviews(recipeId : String) : Result<List<Review>, DataError.Network>
    + addReview(recipeId : String, content : String) : Result<Review, DataError.Network>
  }

  interface RatingRepository <<별점>> {
    + getMyRating(recipeId : String) : Result<RecipeRating?, DataError.Network>
    + submitRating(recipeId : String, score : Int) : Result<RecipeRating, DataError.Network>
  }

  interface FollowRepository <<팔로우>> {
    + isFollowing(userId : String) : Result<Boolean, DataError.Network>
    + follow(userId : String) : Result<Unit, DataError.Network>
    + unfollow(userId : String) : Result<Unit, DataError.Network>
  }

  interface NotificationRepository <<알림>> {
    + getNotifications() : Result<List<Notification>, DataError.Network>
    + markAsRead(notificationId : String) : Result<Unit, DataError.Network>
  }
}

' ------------------------------------------------------------
' 3. Repository → 제공 데이터 (점선: "이 데이터를 준다")
' ------------------------------------------------------------
AuthRepository ..> User
UserRepository ..> User
RecipeRepository ..> Recipe
CategoryRepository ..> Category
RecentSearchRepository ..> Recipe
BookmarkRepository ..> Recipe
ReviewRepository ..> Review
RatingRepository ..> RecipeRating
NotificationRepository ..> Notification

"domain.repository" ..> Result : returns
"domain.repository" ..> DataError : fails with

@enduml
